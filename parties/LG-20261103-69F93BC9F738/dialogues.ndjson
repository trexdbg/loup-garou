{"seq":1,"scene_id":"tour_de_table_01","scene_label":"Jour 1 — Présentations","type":"dialogue_pnj","locuteur":"Iris","texte":"Je préfère les questions franches aux regards de travers.","public":true,"audio":true,"voix_phonon":"Ninon","voix_id_phonon":"qtPlUYAZ4EJDuWMm"}
{"seq":2,"scene_id":"tour_de_table_01","scene_label":"Jour 1 — Présentations","type":"dialogue_pnj","locuteur":"Rose","texte":"Accuser trop vite, c'est risquer de se tromper. Écoutons-nous.","public":true,"audio":true,"voix_phonon":"Noémie","voix_id_phonon":"FXxJ9mANRq6BCTX5"}
{"seq":3,"scene_id":"tour_de_table_01","scene_label":"Jour 1 — Présentations","type":"dialogue_pnj","locuteur":"Marin","texte":"Restons unis ! Mais personne ne devrait être condamné sans raison.","public":true,"audio":true,"voix_phonon":"Arnaud","voix_id_phonon":"aXMVwiUhITMrwPzd"}
{"seq":4,"scene_id":"tour_de_table_01","scene_label":"Jour 1 — Présentations","type":"dialogue_pnj","locuteur":"Mila","texte":"Et toi, Alex, tu penses quoi de tout ça ?","public":true,"audio":true,"voix_phonon":"Orianne","voix_id_phonon":"TUk4X11S6UytB3G6"}
{"seq":5,"scene_id":"tour_de_table_01","scene_label":"Jour 1 — Présentations","type":"dialogue_joueur","locuteur":"Alex","texte":"je suis daccord avec vous","public":true,"audio":false}
{"seq":6,"scene_id":"reveil_jour_2","scene_label":"Jour 2 — Marin a disparu","type":"narration","locuteur":"Narrateur","texte":"Au matin, Marin manque à l'appel. Sa carte est révélée : Simple Villageois. Onze habitants sont encore en vie.","public":true,"audio":false}
{"seq":7,"scene_id":"reveil_jour_2","scene_label":"Jour 2 — Marin a disparu","type":"dialogue_pnj","locuteur":"Jade","texte":"Marin cherchait à calmer tout le monde. Pourquoi lui ?","public":true,"audio":true,"voix_phonon":"Maëlys","voix_id_phonon":"s048cR1l2Jmu4k3B"}
{"seq":8,"scene_id":"reveil_jour_2","scene_label":"Jour 2 — Marin a disparu","type":"dialogue_pnj","locuteur":"Hugo","texte":"Un de nous ment, c'est sûr ! Il faut écouter les paroles de chacun aujourd'hui.","public":true,"audio":true,"voix_phonon":"Augustin","voix_id_phonon":"Tek4tJXiX6_yvXq7"}
{"seq":9,"scene_id":"reveil_jour_2","scene_label":"Jour 2 — Marin a disparu","type":"dialogue_pnj","locuteur":"Léon","texte":"Ne condamnons personne sans preuve. C'est exactement ce que les Loups attendent.","public":true,"audio":true,"voix_phonon":"Lucien","voix_id_phonon":"LIv4NaG8ay4Mhqtd"}
{"seq":10,"scene_id":"debats_jour_2_01","scene_label":"Jour 2 — Alex garde le silence","type":"action_joueur","locuteur":"Alex","texte":"Alex ne dit rien.","saisie_joueur":"alex ne dit rien","public":true,"audio":false}
{"seq":11,"scene_id":"debats_jour_2_01","scene_label":"Jour 2 — Alex garde le silence","type":"dialogue_pnj","locuteur":"Hugo","texte":"Alex se tait depuis ce matin. Ça ne vous paraît pas étrange ?","public":true,"audio":true,"voix_phonon":"Augustin","voix_id_phonon":"Tek4tJXiX6_yvXq7"}
{"seq":12,"scene_id":"debats_jour_2_01","scene_label":"Jour 2 — Alex garde le silence","type":"dialogue_pnj","locuteur":"Rose","texte":"Le silence n'est pas une preuve, Hugo. Tu accuses sans écouter.","public":true,"audio":true,"voix_phonon":"Noémie","voix_id_phonon":"FXxJ9mANRq6BCTX5"}
{"seq":13,"scene_id":"debats_jour_2_01","scene_label":"Jour 2 — Alex garde le silence","type":"dialogue_pnj","locuteur":"Jade","texte":"Léon, tu nous dis d'attendre, mais qu'est-ce que tu proposes ?","public":true,"audio":true,"voix_phonon":"Maëlys","voix_id_phonon":"s048cR1l2Jmu4k3B"}
{"seq":14,"scene_id":"debats_jour_2_01","scene_label":"Jour 2 — Alex garde le silence","type":"dialogue_pnj","locuteur":"Léon","texte":"D'éviter de condamner un innocent. Et toi, pourquoi cette insistance ?","public":true,"audio":true,"voix_phonon":"Lucien","voix_id_phonon":"LIv4NaG8ay4Mhqtd"}
{"seq":15,"scene_id":"votes_jour_2_01","scene_label":"Jour 2 — Vote des habitants","type":"narration","locuteur":"Narrateur","texte":"Les dix autres habitants ont voté. Alex doit encore voter.","public":true,"audio":false}
{"seq":16,"scene_id":"verdict_jour_2","scene_label":"Jour 2 — Verdict","type":"dialogue_joueur","locuteur":"Alex","texte":"Je vote Hugo.","public":true,"audio":false}
{"seq":17,"scene_id":"verdict_jour_2","scene_label":"Jour 2 — Verdict","type":"narration","locuteur":"Narrateur","texte":"Hugo recueille cinq voix, Léon quatre, Jade et Alex une chacun. Hugo est éliminé : sa carte révèle un Simple Villageois. Dix habitants restent en vie. Le village s'endort.","public":true,"audio":false}
